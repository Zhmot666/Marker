// @strict-types
#Область ПрограммныйИнтерфейс

// Выполняет HTTP-запрос к указанному URL и возвращает ответ в виде структуры.
//
// Параметры:
//   URL - Строка - полный URL запроса
//   Метод - Строка - HTTP-метод (GET, POST и т.д.)
//   ТелоЗапроса - Строка - тело запроса в формате JSON
//   Заголовки - Соответствие из Строка, Строка - дополнительные заголовки запроса
//   ТаймаутСекунды - Число - таймаут соединения в секундах
//
// Возвращаемое значение:
//   Структура:
//     * Успешно - Булево - признак успешности запроса (код ответа 2xx)
//     * КодОтветаHTTP - Число - код состояния HTTP
//     * ТелоОтветаБинарный - ДвоичныеДанные, Неопределено - тело ответа в бинарном виде
//     * ТекстОшибки - Строка - текст ошибки при неуспешном выполнении
//
Функция ВыполнитьЗапрос(URL, Метод, ТелоЗапроса = "", Заголовки = Неопределено, ТаймаутСекунды = 30) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("КодОтветаHTTP", 0);
	Результат.Вставить("ТелоОтветаБинарный", Неопределено);
	Результат.Вставить("ТекстОшибки", "");

	Попытка
		ПараметрыURL = РазобратьURL(URL);
		Если Не ПараметрыURL.Успешно Тогда
			Результат.ТекстОшибки = ПараметрыURL.ТекстОшибки;
			Возврат Результат;

		КонецЕсли;

		Соединение = Новый HTTPСоединение(
			ПараметрыURL.Хост,
			ПараметрыURL.Порт,
			ПараметрыURL.Пользователь,
			ПараметрыURL.Пароль,
			Неопределено,
			ТаймаутСекунды,
			ПараметрыURL.ЗащищенноеСоединение);

		Запрос = Новый HTTPЗапрос(ПараметрыURL.ПутьИЗапрос);
		Запрос.Метод = ?(Метод = Неопределено, "GET", Метод);
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

		Если Заголовки <> Неопределено Тогда
			Для Каждого Элемент Из Заголовки Цикл
				Запрос.Заголовки.Вставить(Элемент.Ключ, Элемент.Значение);
			КонецЦикла;
		КонецЕсли;

		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
		КонецЕсли;

		Ответ = Соединение.ОтправитьДляОбработки(Запрос);

		Результат.КодОтветаHTTP = Ответ.КодСостояния;
		Результат.Успешно = (Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300);

		ПотокТела = Ответ.ПолучитьТелоКакПоток();
		Если ПотокТела <> Неопределено И ПотокТела.Размер() > 0 Тогда
			ЧтениеДанных = Новый ЧтениеДанных(ПотокТела);
			РезультатЧтения = ЧтениеДанных.Прочитать();
			Результат.ТелоОтветаБинарный = РезультатЧтения.ПолучитьДвоичныеДанные();
		КонецЕсли;

		Если Не Результат.Успешно Тогда
			Результат.ТекстОшибки = СтрШаблон("HTTP %1", Ответ.КодСостояния);
			Если Ответ.Заголовки.Получить("Content-Type") <> Неопределено И СтрНайти(НРег(Ответ.Заголовки.Получить("Content-Type")), "application/json") > 0 Тогда
				Попытка
					ТекстОтвета = ПолучитьСтрокуИзДвоичныхДанных(Результат.ТелоОтветаБинарный, КодировкаТекста.UTF8);
					Если ЗначениеЗаполнено(ТекстОтвета) Тогда
						Результат.ТекстОшибки = Результат.ТекстОшибки + ": " + Лев(ТекстОтвета, 500);
					КонецЕсли;
				Исключение
					Результат.ТекстОшибки = Результат.ТекстОшибки + ": ошибка декодирования ответа";
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;

	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разбирает URL на компоненты для HTTPСоединения.
// Возвращает структуру: Успешно, Хост, Порт, ПутьИЗапрос, Пользователь, Пароль, ЗащищенноеСоединение, ТекстОшибки
Функция РазобратьURL(URL)
	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("Хост", "");
	Результат.Вставить("Порт", 0);
	Результат.Вставить("ПутьИЗапрос", "");
	Результат.Вставить("Пользователь", "");
	Результат.Вставить("Пароль", "");
	Результат.Вставить("ЗащищенноеСоединение", Неопределено);
	Результат.Вставить("ТекстОшибки", "");

	URL = СокрЛП(URL);
	Если Не ЗначениеЗаполнено(URL) Тогда
		Результат.ТекстОшибки = "URL не указан";
		Возврат Результат;
	КонецЕсли;

	ПозицияПротокола = СтрНайти(URL, "://");
	Если ПозицияПротокола = 0 Тогда
		Результат.ТекстОшибки = "Некорректный URL: отсутствует протокол";
		Возврат Результат;
	КонецЕсли;

	Протокол = Лев(URL, ПозицияПротокола - 1);
	Результат.ЗащищенноеСоединение = (НРег(Протокол) = "https");
	ОстатокURL = Сред(URL, ПозицияПротокола + 3);

	ПозицияСлеша = СтрНайти(ОстатокURL, "/");
	Если ПозицияСлеша > 0 Тогда
		ХостИПорт = Лев(ОстатокURL, ПозицияСлеша - 1);
		Результат.ПутьИЗапрос = Сред(ОстатокURL, ПозицияСлеша);
	Иначе
		ХостИПорт = ОстатокURL;
		Результат.ПутьИЗапрос = "/";
	КонецЕсли;

	ПозицияСобаки = СтрНайти(ХостИПорт, "@");
	Если ПозицияСобаки > 0 Тогда
		УчетныеДанные = Лев(ХостИПорт, ПозицияСобаки - 1);
		ХостИПорт = Сред(ХостИПорт, ПозицияСобаки + 1);
		ПозицияДвоеточия = СтрНайти(УчетныеДанные, ":");
		Если ПозицияДвоеточия > 0 Тогда
			Результат.Пользователь = Лев(УчетныеДанные, ПозицияДвоеточия - 1);
			Результат.Пароль = Сред(УчетныеДанные, ПозицияДвоеточия + 1);
		Иначе
			Результат.Пользователь = УчетныеДанные;
		КонецЕсли;
	КонецЕсли;

	ПозицияДвоеточияПорт = СтрНайти(ХостИПорт, ":");
	Если ПозицияДвоеточияПорт > 0 Тогда
		Результат.Хост = Лев(ХостИПорт, ПозицияДвоеточияПорт - 1);
		СтрокаПорт = Сред(ХостИПорт, ПозицияДвоеточияПорт + 1);
		Результат.Порт = ?(ЗначениеЗаполнено(СтрокаПорт), Число(СтрокаПорт), 0);
	Иначе
		Результат.Хост = ХостИПорт;
		Результат.Порт = 0;
	КонецЕсли;

	Если Результат.Порт = 0 Тогда
		Результат.Порт = ?(Результат.ЗащищенноеСоединение, 443, 80);
	КонецЕсли;

	Результат.Успешно = ЗначениеЗаполнено(Результат.Хост);
	Если Не Результат.Успешно Тогда
		Результат.ТекстОшибки = "Не удалось определить хост в URL";
	КонецЕсли;

	Возврат Результат;
КонецФункции

#КонецОбласти
