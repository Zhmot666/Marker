// @strict-types
#Область ПрограммныйИнтерфейс

// Читает JSON из строки или двоичных данных и преобразует его в значение 1С.
//
// Параметры:
//   Источник - Строка, ДвоичныеДанные - JSON-текст или двоичные данные
//   Кодировка - КодировкаТекста - кодировка для двоичных данных (по умолчанию UTF8)
//
// Возвращаемое значение:
//   Структура из Строка - результат разбора JSON
//
Функция ПрочитатьJSONМаркировки(Источник, Кодировка = Неопределено) Экспорт
	Если Кодировка = Неопределено Тогда
		Кодировка = КодировкаТекста.UTF8;
	КонецЕсли;

	СтрокаJSON = "";
	Если ТипЗнч(Источник) = Тип("ДвоичныеДанные") Тогда
		ЧтениеТекста = Новый ЧтениеТекста(Источник, Кодировка);
		СтрокаJSON = ЧтениеТекста.Прочитать();
	ИначеЕсли ТипЗнч(Источник) = Тип("Строка") Тогда
		СтрокаJSON = Источник;
	Иначе
		Возврат ПрочитатьЗначениеJSON("");

	КонецЕсли;

	// 8.3.23+: ПрочитатьЗначениеJSON. Для более старых версий — ЧтениеJSON + ПрочитатьJSON
	Возврат ПрочитатьЗначениеJSON(СтрокаJSON);
КонецФункции

// Записывает значение в JSON-строку.
//
// Параметры:
// Значение - Структура из Строка - значение для сериализации
//
// Возвращаемое значение:
//  Строка - JSON-текст
//
Функция ЗаписатьJSONМаркировки(Значение) Экспорт
	// 8.3.23+: ЗаписатьЗначениеJSON. Для более старых версий — ЗаписьJSON + ЗаписатьJSON
	Возврат ЗаписатьЗначениеJSON(Значение);
КонецФункции

#КонецОбласти
