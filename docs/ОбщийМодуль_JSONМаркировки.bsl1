// Общий модуль "JSONМаркировки"
// Серверный. Работа с JSON (чтение, запись).
// Перенести в модуль общего модуля после создания в конфигурации.

#Область ПрограммныйИнтерфейс

// Читает JSON из строки или двоичных данных.
//
// Параметры:
//  Источник - Строка, ДвоичныеДанные - JSON-текст или двоичные данные
//  Кодировка - КодировкаТекста, необязательно - кодировка для двоичных данных (по умолчанию UTF8)
//
// Возвращаемое значение:
//  Структура, Массив, или примитивное значение - результат разбора JSON
//
Функция ПрочитатьJSON(Источник, Кодировка = Неопределено) Экспорт
	Если Кодировка = Неопределено Тогда
		Кодировка = КодировкаТекста.UTF8;
	КонецЕсли;

	СтрокаJSON = "";
	Если ТипЗнч(Источник) = Тип("ДвоичныеДанные") Тогда
		СтрокаJSON = Источник.ПолучитьСтроку(Кодировка);
	ИначеЕсли ТипЗнч(Источник) = Тип("Строка") Тогда
		СтрокаJSON = Источник;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	// 8.3.23+: ПрочитатьЗначениеJSON. Для более старых версий — ЧтениеJSON + ПрочитатьJSON
	Возврат ПрочитатьЗначениеJSON(СтрокаJSON);
КонецФункции

// Записывает значение в JSON-строку.
//
// Параметры:
//  Значение - Структура, Массив, и т.д. - значение для сериализации
//
// Возвращаемое значение:
//  Строка - JSON-текст
//
Функция ЗаписатьJSON(Значение) Экспорт
	// 8.3.23+: ЗаписатьЗначениеJSON. Для более старых версий — ЗаписьJSON + ЗаписатьJSON
	Возврат ЗаписатьЗначениеJSON(Значение);
КонецФункции

#КонецОбласти
