// Общий модуль "ОчередьОбменаМаркировки"
// Серверный. Логика работы с очередью обмена и вызова API маркировки.
// Перенести в модуль общего модуля после создания в конфигурации.

#Область ПрограммныйИнтерфейс

// Добавляет запись в очередь обмена маркировки.
// Страна определяется по ДокументЗаказКодов.Заказ.Контрагент.Страна.
//
// Параметры:
//  ТипОперации - ПеречислениеСсылка.ТипОперацииОчередиМаркировки - тип операции (ЗаказКодов, ОтчетНанесения и т.д.)
//  ТелоЗапроса - Строка - тело HTTP-запроса (JSON)
//  ДокументЗаказКодов - ДокументСсылка.ЗаказКодовМаркировки, необязательно - документ заказа кодов (для операций заказа)
//
// Возвращаемое значение:
//  УникальныйИдентификатор - идентификатор созданной записи очереди
//
Функция ДобавитьВОчередь(ТипОперации, ТелоЗапроса, ДокументЗаказКодов = Неопределено) Экспорт
	Идентификатор = Новый УникальныйИдентификатор;

	МенеджерЗаписи = РегистрыСведений.ОчередьОбменаМаркировки.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Идентификатор = Идентификатор;
	МенеджерЗаписи.ТипОперации = ТипОперации;
	МенеджерЗаписи.ТелоЗапроса = ПоместитьВХранилище(ТелоЗапроса);
	МенеджерЗаписи.ДокументЗаказКодов = ДокументЗаказКодов;
	МенеджерЗаписи.Статус = Перечисления.СтатусЗаписиОчередиМаркировки.КВыполнению;
	МенеджерЗаписи.СчетчикПовторов = 0;
	МенеджерЗаписи.ДатаСледующейПопытки = ТекущаяДата();
	МенеджерЗаписи.ДатаСоздания = ТекущаяДата();
	МенеджерЗаписи.Записать();

	Возврат Идентификатор;
КонецФункции

// Обрабатывает очередь обмена: выбирает записи к выполнению, выполняет HTTP-запросы, обновляет статусы.
// При успехе для типа ЗаказКодов создаёт документ ПоступлениеКодовМаркировки.
// Модальный вопрос при ручном запуске проверяется на клиенте до вызова; при регламентном задании не показывается.
//
Процедура ОбработатьОчередь() Экспорт
	МаксимумПовторов = 5;
	ИнтервалПовтораМинут = 5;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ОчередьОбменаМаркировки.Идентификатор КАК Идентификатор,
		|	ОчередьОбменаМаркировки.ТипОперации КАК ТипОперации,
		|	ОчередьОбменаМаркировки.ТелоЗапроса КАК ТелоЗапроса,
		|	ОчередьОбменаМаркировки.ДокументЗаказКодов КАК ДокументЗаказКодов,
		|	ОчередьОбменаМаркировки.СчетчикПовторов КАК СчетчикПовторов
		|ИЗ
		|	РегистрСведений.ОчередьОбменаМаркировки КАК ОчередьОбменаМаркировки
		|ГДЕ
		|	ОчередьОбменаМаркировки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусЗаписиОчередиМаркировки.КВыполнению)
		|	И (ОчередьОбменаМаркировки.ДатаСледующейПопытки <= &ТекущаяДата
		|		ИЛИ НЕ ОчередьОбменаМаркировки.ДатаСледующейПопытки.ЗНАЧЕНИЕ ЗАПОЛНЕНО)";

	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбработатьЗаписьОчереди(Выборка.Идентификатор, Выборка.ТипОперации, Выборка.ТелоЗапроса,
			Выборка.ДокументЗаказКодов, Выборка.СчетчикПовторов, МаксимумПовторов, ИнтервалПовтораМинут);
	КонецЦикла;
КонецПроцедуры

// Устанавливает запись очереди на повторную попытку через указанный интервал.
//
// Параметры:
//  ИдентификаторЗаписи - УникальныйИдентификатор - идентификатор записи очереди
//  ИнтервалМинут - Число - интервал до следующей попытки в минутах
//
Процедура ПовторнаяПопытка(ИдентификаторЗаписи, ИнтервалМинут = 5) Экспорт
	МенеджерЗаписи = РегистрыСведений.ОчередьОбменаМаркировки.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Идентификатор = ИдентификаторЗаписи;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.Статус = Перечисления.СтатусЗаписиОчередиМаркировки.КВыполнению;
		МенеджерЗаписи.СчетчикПовторов = МенеджерЗаписи.СчетчикПовторов + 1;
		МенеджерЗаписи.ДатаСледующейПопытки = ДобавитьКДате(ТекущаяДата(), 0, 0, ИнтервалМинут * 60, 0);
		МенеджерЗаписи.Записать();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обрабатывает одну запись очереди: HTTP-запрос, лог, обновление статуса, при успехе — создание ПоступлениеКодовМаркировки.
Процедура ОбработатьЗаписьОчереди(Идентификатор, ТипОперации, ТелоЗапроса, ДокументЗаказКодов, СчетчикПовторов, МаксимумПовторов, ИнтервалПовтораМинут)
	Страна = Неопределено;
	Если ЗначениеЗаполнено(ДокументЗаказКодов) Тогда
		ДокОбъект = ДокументЗаказКодов.ПолучитьОбъект();
		Если ДокОбъект <> Неопределено И ЗначениеЗаполнено(ДокОбъект.Заказ) Тогда
			ЗаказОбъект = ДокОбъект.Заказ.ПолучитьОбъект();
			Если ЗаказОбъект <> Неопределено И ЗначениеЗаполнено(ЗаказОбъект.Контрагент) Тогда
				КонтрагентОбъект = ЗаказОбъект.Контрагент.ПолучитьОбъект();
				Если КонтрагентОбъект <> Неопределено Тогда
					Страна = КонтрагентОбъект.Страна;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Страна) Тогда
		ОбновитьСтатусОчереди(Идентификатор, Перечисления.СтатусЗаписиОчередиМаркировки.Ошибка,
			"Не удалось определить страну по документу заказа кодов", СчетчикПовторов, МаксимумПовторов, ИнтервалПовтораМинут);
		Возврат;
	КонецЕсли;

	URL = НастройкиОбменаМаркировкиСервер.ПолучитьURLОператора(Страна);
	Если Не ЗначениеЗаполнено(URL) Тогда
		ОбновитьСтатусОчереди(Идентификатор, Перечисления.СтатусЗаписиОчередиМаркировки.Ошибка,
			"Не настроен URL оператора для страны " + Строка(Страна), СчетчикПовторов, МаксимумПовторов, ИнтервалПовтораМинут);
		Возврат;
	КонецЕсли;

	// TODO: добавить путь API по типу операции и стране (Этап 5). Пока — базовый URL.
	ПолныйURL = URL;
	КлючAPI = НастройкиОбменаМаркировкиСервер.ПолучитьКлючAPI(Страна);
	Таймаут = НастройкиОбменаМаркировкиСервер.ПолучитьТаймаутЗапросаСекунды(Страна);

	Заголовки = Новый Соответствие;
	Если ЗначениеЗаполнено(КлючAPI) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + КлючAPI);
	КонецЕсли;

	ТелоЗапросаСтрока = "";
	Если ТипЗнч(ТелоЗапроса) = Тип("ХранилищеЗначения") Тогда
		ТелоЗапросаСтрока = ИзвлечьИзХранилища(ТелоЗапроса);
	ИначеЕсли ТипЗнч(ТелоЗапроса) = Тип("Строка") Тогда
		ТелоЗапросаСтрока = ТелоЗапроса;
	КонецЕсли;

	РезультатHTTP = HTTPКлиентМаркировки.ВыполнитьЗапрос(ПолныйURL, "POST", ТелоЗапросаСтрока, Заголовки, Таймаут);

	ЗаписатьВЛог(Идентификатор, ТипОперации, Страна, РезультатHTTP.Успешно, РезультатHTTP.КодОтветаHTTP,
		ТелоЗапросаСтрока, РезультатHTTP.ТелоОтветаБинарный, РезультатHTTP.ТекстОшибки);

	Если РезультатHTTP.Успешно Тогда
		ОбновитьСтатусОчереди(Идентификатор, Перечисления.СтатусЗаписиОчередиМаркировки.Выполнен, "", СчетчикПовторов, МаксимумПовторов, ИнтервалПовтораМинут);

		Если ТипОперации = Перечисления.ТипОперацииОчередиМаркировки.ЗаказКодов И ЗначениеЗаполнено(ДокументЗаказКодов) Тогда
			СоздатьПоступлениеКодов(ДокументЗаказКодов, Страна, РезультатHTTP.ТелоОтветаБинарный);
		КонецЕсли;
	Иначе
		ОбновитьСтатусОчереди(Идентификатор, Перечисления.СтатусЗаписиОчередиМаркировки.Ошибка,
			РезультатHTTP.ТекстОшибки, СчетчикПовторов, МаксимумПовторов, ИнтервалПовтораМинут);
	КонецЕсли;
КонецПроцедуры

// Обновляет статус записи очереди. При ошибке и не достигнутом лимите — ставит КВыполнению с отложенной датой; при лимите — ТребуетРазбора.
Процедура ОбновитьСтатусОчереди(Идентификатор, НовыйСтатус, ТекстОшибки, СчетчикПовторов, МаксимумПовторов, ИнтервалПовтораМинут)
	МенеджерЗаписи = РегистрыСведений.ОчередьОбменаМаркировки.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Идентификатор = Идентификатор;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.Статус = НовыйСтатус;
		МенеджерЗаписи.ТекстОшибки = ТекстОшибки;
		Если НовыйСтатус = Перечисления.СтатусЗаписиОчередиМаркировки.Ошибка Тогда
			МенеджерЗаписи.СчетчикПовторов = СчетчикПовторов + 1;
			Если МенеджерЗаписи.СчетчикПовторов >= МаксимумПовторов Тогда
				МенеджерЗаписи.Статус = Перечисления.СтатусЗаписиОчередиМаркировки.ТребуетРазбора;
			Иначе
				МенеджерЗаписи.Статус = Перечисления.СтатусЗаписиОчередиМаркировки.КВыполнению;
				МенеджерЗаписи.ДатаСледующейПопытки = ДобавитьКДате(ТекущаяДата(), 0, 0, ИнтервалПовтораМинут * 60, 0);
			КонецЕсли;
		КонецЕсли;
		МенеджерЗаписи.Записать();
	КонецЕсли;
КонецПроцедуры

// Записывает обращение к API в регистр ЛогОбращенийAPIМаркировки.
Процедура ЗаписатьВЛог(ИдентификаторОчереди, ТипОперации, Страна, Успешно, КодОтветаHTTP, ТелоЗапроса, ТелоОтветаБинарный, ТекстОшибки)
	ИдентификаторЛога = Новый УникальныйИдентификатор;
	МенеджерЗаписи = РегистрыСведений.ЛогОбращенийAPIМаркировки.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Идентификатор = ИдентификаторЛога;
	МенеджерЗаписи.МоментВремени = ТекущаяДата();
	МенеджерЗаписи.ТипОперации = ТипОперации;
	МенеджерЗаписи.Страна = Страна;
	МенеджерЗаписи.Успешно = Успешно;
	МенеджерЗаписи.КодОтветаHTTP = КодОтветаHTTP;
	МенеджерЗаписи.ТелоЗапроса = ?(ЗначениеЗаполнено(ТелоЗапроса), ПоместитьВХранилище(ТелоЗапроса), Неопределено);
	МенеджерЗаписи.ТелоОтветаБинарный = ?(ТелоОтветаБинарный <> Неопределено, ПоместитьВХранилище(ТелоОтветаБинарный), Неопределено);
	МенеджерЗаписи.ТекстОшибки = ТекстОшибки;
	МенеджерЗаписи.ИдентификаторЗаписиОчереди = ИдентификаторОчереди;
	МенеджерЗаписи.Записать();
КонецПроцедуры

// Создаёт документ ПоступлениеКодовМаркировки по успешному ответу API.
// Разбор тела ответа и заполнение ТЧ «Коды» — на Этапе 5 (форматы операторов).
Процедура СоздатьПоступлениеКодов(ДокументЗаказКодов, Страна, ТелоОтветаБинарный)
	Оператор = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОператорыМаркировки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ОператорыМаркировки КАК ОператорыМаркировки
		|ГДЕ
		|	ОператорыМаркировки.Страна = &Страна
		|	И ОператорыМаркировки.Активный = ИСТИНА";
	Запрос.УстановитьПараметр("Страна", Страна);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		Оператор = Выборка.Ссылка;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Оператор) Тогда
		Возврат;
	КонецЕсли;

	// TODO Этап 5: разбор ТелоОтветаБинарный по формату API, подсчёт кодов, заполнение ТЧ Коды
	КоличествоКодов = 0;

	НовыйДокумент = Документы.ПоступлениеКодовМаркировки.СоздатьДокумент();
	НовыйДокумент.Оператор = Оператор;
	НовыйДокумент.ЗаказКодов = ДокументЗаказКодов;
	НовыйДокумент.ОтветAPIБинарный = ПоместитьВХранилище(ТелоОтветаБинарный);
	НовыйДокумент.КоличествоКодов = КоличествоКодов;
	НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

// Помещает строку или двоичные данные в ХранилищеЗначения.
// Строка — UTF-8. ДвоичныеДанные — через Base64 (совместимость с разными версиями платформы).
Функция ПоместитьВХранилище(Значение)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	СтрокаДляЗаписи = "";
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		СтрокаДляЗаписи = Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
		СтрокаДляЗаписи = Base64Строка(Значение);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	Хранилище = Новый ХранилищеЗначения;
	Поток = Хранилище.ОткрытьПотокДляЗаписи();
	ЗаписьТекста = Новый ЗаписьТекста(Поток, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(СтрокаДляЗаписи);
	ЗаписьТекста.Закрыть();
	Хранилище.ЗакрытьПотокЗаписи(Поток);
	Возврат Хранилище;
КонецФункции

// Извлекает строку из ХранилищеЗначения (UTF-8).
Функция ИзвлечьИзХранилища(Хранилище)
	Если Хранилище = Неопределено Или Не ТипЗнч(Хранилище) = Тип("ХранилищеЗначения") Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Поток = Хранилище.ОткрытьПотокДляЧтения();
		ЧтениеТекста = Новый ЧтениеТекста(Поток, КодировкаТекста.UTF8);
		Результат = ЧтениеТекста.Прочитать();
		ЧтениеТекста.Закрыть();
		Возврат Результат;
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

#КонецОбласти
